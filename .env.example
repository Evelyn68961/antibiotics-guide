# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit it.

# Get this from https://www.notion.so/my-integrations
# (create an integration, then copy its "Internal Integration Secret")
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The database ID is the 32-char string in your Notion database URL.
# For https://www.notion.so/20dc496dfff18072af9bc0e058189034?v=…
# the database ID is: 20dc496dfff18072af9bc0e058189034
NOTION_DATABASE_ID=20dc496dfff18072af9bc0e058189034
